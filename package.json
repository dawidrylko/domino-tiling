{
  "name": "domino-tiling",
  "version": "1.1.0",
  "private": true,
  "description": "Count and render every domino tiling of a 2n×2n board (OEIS A004003): bitmask dynamic programming solvers (Number and BigInt), an exact closed-form formula solver, an unranking renderer and an online gallery; plus domicule tilings (king's graph perfect matchings, OEIS A239264 and A239273).",
  "keywords": [
    "a004003",
    "a239264",
    "a239273",
    "oeis",
    "domino-tiling",
    "dimer-coverings",
    "domicule",
    "kings-graph",
    "perfect-matchings",
    "chinese-remainder-theorem",
    "combinatorics",
    "mathematics",
    "algorithm",
    "dynamic-programming",
    "bitmask",
    "broken-profile",
    "kasteleyn",
    "resultant",
    "unranking",
    "coupling-from-the-past",
    "random-sampling",
    "bigint",
    "svg",
    "visualization",
    "javascript",
    "nodejs"
  ],
  "author": {
    "name": "Dawid Ryłko",
    "url": "https://dawidrylko.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidrylko/domino-tiling.git"
  },
  "bugs": {
    "url": "https://github.com/dawidrylko/domino-tiling/issues"
  },
  "homepage": "https://dawidrylko.github.io/domino-tiling/",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node benchmarkRunner.js -n 1000 -m 7",
    "benchmark": "node benchmarkRunner.js -n 1000 -m 7 && node benchmarkRunner.js -n 1000 -o 7 --only dominoTilingSolver-Formula.js && node benchmarkRunner.js -n 10 -m 2 -o 7 --only dominoTilingSolver-BigInt.js && node benchmarkRunner.js -n 1 -o 9 --only dominoTilingSolver-BigInt.js",
    "benchmark:domicule": "node benchmarkRunner.js --domicule -n 10 -m 9 && node benchmarkRunner.js --domicule -n 1 -o 9 --only domiculeTilingSolver-Modular.js",
    "test": "node testRunner.js -m 7",
    "render": "node dominoTilingRenderer.js",
    "test:render": "node renderTestRunner.js",
    "test:pari": "node pariTestRunner.js",
    "test:site": "node siteTestRunner.js",
    "site:build": "node site/build.js"
  }
}
